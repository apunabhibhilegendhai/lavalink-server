# ==============================================================================
# DISCORD MULTI-BOT FLEET CREDENTIALS (Jockie Architecture)
# Get these from https://discord.com/developers/applications
# ==============================================================================
# Primary Bot (Pulse)
DISCORD_TOKEN=YOUR_PRIMARY_DISCORD_BOT_TOKEN
CLIENT_ID=YOUR_PRIMARY_CLIENT_ID
GUILD_ID=

# Additional Bot Tokens (Optional: for Multi-Bot in same server)
DISCORD_TOKEN_2=YOUR_SECOND_BOT_TOKEN
CLIENT_ID_2=YOUR_SECOND_CLIENT_ID

DISCORD_TOKEN_3=YOUR_THIRD_BOT_TOKEN
CLIENT_ID_3=YOUR_THIRD_CLIENT_ID

DISCORD_TOKEN_4=YOUR_FOURTH_BOT_TOKEN
CLIENT_ID_4=YOUR_FOURTH_CLIENT_ID

# Comma-separated list of all bot user IDs for arbitration
ALL_BOT_IDS=YOUR_PRIMARY_CLIENT_ID,YOUR_SECOND_CLIENT_ID,YOUR_THIRD_CLIENT_ID,YOUR_FOURTH_CLIENT_ID

# Alternatively, all tokens comma-delimited:
# DISCORD_TOKENS=token1,token2,token3,token4

# ==============================================================================
# DISCORD SHARDING & CLUSTERING (Supports 1M+ Servers)
# ==============================================================================
SHARDS_TOTAL=auto
SHARDS_PER_CLUSTER=auto

# ==============================================================================
# SELF-HOSTED LAVALINK v4.2.2 NODE CONFIGURATION
# Preconfigured for your live node: lavalink.opendrive.indevs.in
# ==============================================================================
LAVALINK_HOST=lavalink.opendrive.indevs.in
LAVALINK_PORT=443
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=true
LAVALINK_ID=Primary-Ultra-Node

# ==============================================================================
# BOT CUSTOMIZATION & BEHAVIOR
# ==============================================================================
DEFAULT_VOLUME=100
DEFAULT_SEARCH_PLATFORM=spsearch
USE_COMPONENTS_V2=true
EMBED_COLOR=#7B2CBF
SUCCESS_COLOR=#2EC4B6
ERROR_COLOR=#E63946
WARNING_COLOR=#FFB703
INACTIVITY_TIMEOUT_MS=180000
EMPTY_CHANNEL_TIMEOUT_MS=120000

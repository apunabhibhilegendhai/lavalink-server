{
  "name": "pulse-music-bot",
  "version": "1.0.0",
  "description": "Enterprise-scale Discord Music Bot powered by Lavalink v4.2.2 with Discord ShardingManager, capable of scaling to 1M+ servers with sub-millisecond latency and Components V2",
  "main": "src/sharder.js",
  "scripts": {
    "start": "node src/sharder.js",
    "start:direct": "node src/index.js",
    "deploy": "node src/deploy-commands.js",
    "sync-emojis": "node scripts/sync-emojis.js",
    "dev": "node --watch src/index.js"
  },
  "keywords": [
    "discord-bot",
    "lavalink",
    "lavalink-v4",
    "music-bot",
    "discordjs",
    "sharding",
    "components-v2",
    "audio-filters",
    "spotify",
    "youtube",
    "lyrics"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "lavalink-client": "^2.11.0",
    "sharp": "^0.35.5"
  }
}
